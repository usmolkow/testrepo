# Игнорировать все файлы логов
*.log
*.log.*
/var/log/
log/

# Игнорировать архивы и бинарные файлы
*.tar.gz
*.zip
*.rar
*.bin
*.exe
*.so
*.db
*.sqlite
*.avi
*.mp4

# Игнорировать временные файлы и кэш
*~
*.swp
*.tmp
.cache/

# Игнорировать приватные ключи и сертификаты (ОБЯЗАТЕЛЬНО!)
*.pem
*.key
*.crt
id_rsa
id_ed25519
*.p12
*.pfx

# Игнорировать специфичные для приложений секреты
.env
.env.local
*.secret
config/secrets.yml

# Игнорировать системные директории
/proc/
/sys/
/dev/
/run/
/tmp/
/srv/
